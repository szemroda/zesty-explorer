{
  "name": "zestyx",
  "version": "0.1.0",
  "description": "Zesty Explorer: a local, read-only browser for Zesty content and code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szemroda/zesty-explorer.git"
  },
  "homepage": "https://github.com/szemroda/zesty-explorer#readme",
  "bugs": "https://github.com/szemroda/zesty-explorer/issues",
  "type": "module",
  "bin": {
    "zestyx": "build/cli/index.js"
  },
  "files": [
    "build/cli",
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build && tsc -p tsconfig.cli.build.json",
    "start": "node build/cli/index.js",
    "prepack": "pnpm build",
    "check": "pnpm format:check && pnpm lint && tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@base-ui/react": "1.8.0",
    "@effect/language-service": "0.87.2",
    "@effect/platform": "0.97.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "effect": "3.22.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fflate": "0.8.2",
    "globals": "16.4.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.45.0",
    "microdiff": "1.6.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
